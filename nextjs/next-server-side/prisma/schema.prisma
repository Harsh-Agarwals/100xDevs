generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id    Int    @id @default(autoincrement())
  name  String
  email String
  posts Post[]
}

model Post {
  id       Int     @id @default(autoincrement())
  title    String?
  authorId Int
  Admin    Admin   @relation(fields: [authorId], references: [id])
}

model Person {
  id    Int     @id @default(autoincrement())
  name  String?
  email String  @unique
  Todo  Todo[]
}

model Todo {
  id          Int     @id @default(autoincrement())
  title       String
  description String?
  done        Boolean @default(false)
  createdBy   Int?
  Person      Person? @relation(fields: [createdBy], references: [id])
}

model User {
  id        Int     @id @default(autoincrement())
  email     String
  firstName String?
  lastName  String?
  password  String
}
